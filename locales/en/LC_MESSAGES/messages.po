msgstr "Auto-approve is OFF. Requests are no longer approved or counted."

#: bot.py:245
#, python-brace-format
msgid "⚠️ I was removed from «{title}» and stopped approving requests."
msgstr "⚠️ I was removed from «{title}» and stopped approving requests."

#: bot.py:267
#, python-brace-format
msgid ""
"❌ Only the <b>owner</b> of «{title}» can connect it — being an administrator is not enough. I "
"have left the channel; ask the owner to add me."
msgstr ""
"❌ Only the <b>owner</b> of «{title}» can connect it — being an administrator is not enough. I "
"have left the channel; ask the owner to add me."

#: bot.py:287
#, python-brace-format
msgid ""
"⚠️ «{title}» is connected, but I have no <b>Add members</b> right — without it Telegram does not "
"even send me the join requests. Grant it in the channel's admin settings."
msgstr ""
"⚠️ «{title}» is connected, but I have no <b>Add members</b> right — without it Telegram does not "
"even send me the join requests. Grant it in the channel's admin settings."

#: bot.py:297
