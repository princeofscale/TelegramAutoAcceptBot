# Токен от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Соль для HMAC идентификаторов заявителей.
# ВАЖНО: задать один раз и больше НИКОГДА не менять — при смене соли
# все прошлые заявки перестанут сопоставляться с отписками, статистика обнулится.
# Сгенерировать: python3 -c "import secrets; print(secrets.token_hex(32))"
HASH_SALT=

# Путь к файлу базы
DB_PATH=bot.db
